{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tauri core, plus the native shell: open links in the default browser, and save/open backup files through the system panels.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:window:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "core:webview:allow-print"
  ]
}