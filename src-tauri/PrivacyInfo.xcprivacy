<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest — required for App Store submissions since 1 May 2024.

  This file declares (a) the "required reason" APIs the app calls and why, and
  (b) the data the app collects and whether it is linked to the user or used for
  tracking.

  Scope of this app, for the avoidance of doubt:
    - No accounts, no sign-in, no user profile.
    - No analytics, no telemetry, no crash reporting, no advertising, no tracking.
    - All recipe data lives in a local IndexedDB store inside the app container.
    - The only network traffic is user-initiated: importing a recipe from a URL
      the user pastes, the OCR worker download, and optional sync to a storage
      provider the user configures with their own credentials.
-->
<plist version="1.0">
<dict>

  <!--
    ===================================================================
    NSPrivacyTracking
    ===================================================================
    The app does no cross-app or cross-site tracking. No ad SDKs, no
    fingerprinting, no IDFA/IDFV use.
  -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- No tracking domains, because NSPrivacyTracking is false. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!--
    ===================================================================
    NSPrivacyCollectedDataTypes
    ===================================================================
    `Linked` = false for everything, because nothing is tied to an identity:
    there is no account to link it to.

    `Tracking` = false for everything.

    `Purposes` note that App Functionality and (where applicable) User
    Consent are the only purposes. There is no Analytics, no Advertising.
  -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!--
      Nothing is collected.

      "Collected" means data leaves the device in a way that lets the developer
      or a third party access it. Everything this app handles - recipes, meal
      plans, templates, photos, settings, sync credentials - is stored in the
      app's own container on the user's device. The only outbound traffic is
      user-initiated: a recipe page the user asks to import (through a proxy
      the user can change), the OCR model download, and optional sync to a
      storage provider the user configures with their own credentials. The
      developer operates no server that receives any of it.

      This therefore matches the App Store "Data Not Collected" answer.
    -->
  </array>

  <!--
    ===================================================================
    NSPrivacyAccessedAPITypes  (required-reason APIs)
    ===================================================================
    Apple requires a declared reason for each of a specific list of APIs.
    Only the categories this app actually touches are listed.

    If App Store Connect flags an undeclared API after upload, add its
    category here with the matching approved reason code.
  -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>

    <!--
      File timestamp APIs.

      The app shows a recipe's updatedAt and a backup's exportedAt, and uses
      timestamps to decide which copy wins during sync. It reads timestamps; it
      does not inspect them to fingerprint the user or the device.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>

    <!--
      User defaults / local storage.

      Dexie (IndexedDB) holds the recipes, and localStorage carries the
      BroadcastChannel fallback that keeps the detached timer window in sync
      with the main window.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>

    <!--
      Disk space: deliberately NOT declared.

      A previous revision declared E174.1 here on the assumption that the app
      checks free space before writing a backup. It does not. No disk-space API
      appears anywhere in the source, and `nm -u` on the release binary imports
      none of statfs, statvfs, getattrlist or volumeAvailableCapacity.

      E174.1 additionally requires that "the app must behave differently based
      on disk space in a way that is observable to users", which nothing here
      does. Declaring a category the binary never calls invites a review
      question with no good answer, so the accurate manifest omits it.

      Re-add only if a genuine disk-space check is introduced, and then only
      with a user-visible reaction to low space.
    -->

  </array>

</dict>
</plist>
