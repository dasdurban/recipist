<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the Microsoft Store (MSIX).

  This is not used by the Tauri build; Tauri cannot emit MSIX. The package is
  assembled by `scripts/build-msix.ps1`, which stages the built app into a
  folder and runs MakeAppx over it.

  The identity values below come from Partner Center, under
  Product management > App identity, and are case-sensitive. Tags are
  substituted at build time by the packaging script (see identity.json), so
  nothing here has to be edited by hand.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <!-- Version is quad notation: major.minor.build.revision.
       The Store reserves the fourth field, so it stays 0. -->
  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{IDENTITY_PUBLISHER}}"
    Version="{{IDENTITY_VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>The Recipe App</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Description>A personal recipe organiser</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <!-- Windows 10 2004 (10.0.19041.0) is the floor because the Application
         element below uses uap10:RuntimeBehavior and uap10:TrustLevel, which
         Microsoft introduced in that release. Older builds would need the
         legacy EntryPoint attribute instead. 2004 is well past end of support,
         so this costs nothing. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <!-- The app is a normal Win32 desktop program (Tauri + WebView2), so it
         needs full trust. This is a restricted capability, which is why the
         submission must declare it. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

  <Applications>
    <Application
      Id="Recipist"
      Executable="recipist.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="The Recipe App"
        Description="A personal recipe organiser"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <!-- Claims the recipist:// link the browser button sends. Without this
           the app installs fine but the link has no handler, so clicking the
           bookmark silently does nothing.

           The manifest is the only place this can be declared for a packaged
           app: the deep-link plugin's runtime registration writes a registry
           key, and an MSIX app's writes land in a virtualised hive that the
           shell does not consult when resolving a protocol. On macOS and Linux
           the equivalent is Info.plist and the .desktop file. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="recipist">
            <uap:DisplayName>Save to Recipe App</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
